{
  "name": "perkora",
  "version": "0.1.0",
  "private": true,
  "description": "Perkora — digital loyalty and customer retention for independent cafés.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/dev.ts",
    "start": "node dist/server.cjs",
    "db:migrate": "node dist/cli.cjs migrate",
    "db:seed": "node dist/cli.cjs seed",
    "demo:reset": "node dist/cli.cjs demo-reset",
    "admin:create": "node dist/cli.cjs create-admin",
    "setup": "npm run build && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react-icons": "5.7.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "playwright": "1.63.0"
  }
}
