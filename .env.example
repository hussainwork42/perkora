# Perkora configuration. Copy to .env for local development; set these as real
# environment variables in production (real environment variables always win over .env).

# development | production | test
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public base URL, no trailing slash. Used in QR codes, invitation and claim links,
# and the same-origin (CSRF) check. Use https:// in production — cookies become Secure
# and HSTS is sent automatically.
APP_URL=http://localhost:3000

# Any PostgreSQL 14+ (local, Supabase, Neon, Render, Railway, RDS...).
# sslmode: disable | prefer | require | verify-full  (use require or verify-full for hosted databases)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/perkora?sslmode=disable
DATABASE_POOL_MAX=10
# Optional PEM certificate of the database CA, for sslmode=verify-full with a private CA
# DATABASE_CA_CERT=

# Signs member QR tokens. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it invalidates QR codes currently on screen (they rotate every 5 minutes anyway).
APP_SECRET=replace-with-at-least-32-random-characters

# Set to true only when running behind a reverse proxy / load balancer that sets
# X-Forwarded-For (Render, Railway, Fly, nginx). Used for rate limiting by client IP.
TRUST_PROXY=false

# Demo environment: shows the fictional demo café and its sign-in shortcuts.
# Set to false on a production deployment that should not expose demo accounts.
DEMO_MODE=true
# Password for the fictional demo accounts created by `npm run db:seed`. Not used for real accounts.
DEMO_PASSWORD=choose-a-demo-password

# debug | info | warn | error
LOG_LEVEL=info

# Only read by `npm run admin:create` — never stored in source code. If omitted, a strong
# password is generated and printed once.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Only for `npm test`: a separate database whose name ends in "_test". The tests drop and
# recreate its schema, and refuse to run against any other database.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/perkora_test?sslmode=disable
